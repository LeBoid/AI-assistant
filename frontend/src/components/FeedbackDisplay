.feedback-display {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.feedback-header h2 {
  color: #333;
  font-size: 2rem;
  margin: 0;
}

.score-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3px solid;
  border-radius: 12px;
  padding: 1rem 1.5rem;
  min-width: 120px;
}

.score-value {
  font-size: 2.5rem;
  font-weight: bold;
  line-height: 1;
}

.score-label {
  font-size: 0.9rem;
  font-weight: 600;
  margin-top: 0.25rem;
  text-transform: uppercase;
}

.feedback-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.feedback-section {
  background: #f9fafb;
  padding: 1.5rem;
  border-radius: 12px;
  border-left: 4px solid #667eea;
}

.feedback-section h3 {
  color: #333;
  font-size: 1.3rem;
  margin-bottom: 1rem;
}

.feedback-section p {
  color: #555;
  line-height: 1.7;
  font-size: 1.05rem;
}

.feedback-section ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.feedback-section li {
  padding: 0.75rem 0;
  color: #555;
  line-height: 1.6;
  border-bottom: 1px solid #e5e7eb;
}

.feedback-section li:last-child {
  border-bottom: none;
}

.feedback-section li::before {
  content: '•';
  color: #667eea;
  font-weight: bold;
  display: inline-block;
  width: 1em;
  margin-right: 0.5rem;
}

.feedback-section.strengths {
  border-left-color: #10b981;
}

.feedback-section.improvements {
  border-left-color: #f59e0b;
}

.feedback-footer {
  display: flex;
  justify-content: center;
  padding-top: 1rem;
}

.interview-complete-message {
  text-align: center;
  padding: 1.5rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 12px;
  font-size: 1.1rem;
  font-weight: 600;
}

.btn {
  padding: 0.875rem 2rem;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
}


